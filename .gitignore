# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env.local
scripts/generate-license.js

# local-only demo data seeding script (not shipped)
demo-seed.js

# runtime disk-usage history for /api/server-stats forecast
.data/

# packaging archives (build/distribution output, never source)
*.zip

# NocVault Suite GUI build artifacts (produced by installer/Build-Setup-Exe.ps1)
installer/*.exe

# Ad-hoc diagnostic scratch scripts (read-only DB probes). Local only —
# these were committed by accident by a `git add -A` in 1.34.0.
_*.js

# Offline installer dependency binaries (Node MSI, PostgreSQL, Git, VC++, NSSM).
# ~470 MB of third-party installers fetched at package-build time by
# installer/Build-InstallerPackage.ps1 - they are NOT ours and must never be in
# the repo. GitHub rejects them outright (postgresql-16 alone is 340 MB, over the
# 100 MB hard limit), which is how this was caught.
installer/dependencies/
dist/
