# Database
DATABASE_URL=postgresql://user:password@host/dbname

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Set to true for on-prem (disables SSL for local PostgreSQL)
SSL_DISABLED=false

# Server IP used by the update script (Windows Task Scheduler)
SERVER_IP=your_server_ip

# Secret for internal cron endpoints (health snapshot). Random 32-byte hex.
CRON_SECRET=your-cron-secret-here
